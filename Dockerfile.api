FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY requirements-migrations.txt .
RUN pip install --no-cache-dir -r requirements-migrations.txt
COPY backend ./backend
COPY alembic.ini .
COPY migrations ./migrations
RUN mkdir -p /app/data && chown -R app:app /app

USER app
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*"]

