APP_ENV=development
TZ=Africa/Nairobi

# SQLite remains the supported Phase 1 database. The data directory is bind-mounted in Docker.
DATABASE_URL=sqlite:///./data/digital_kids_assistant.db

# Browser/API connectivity
VITE_API_BASE_URL=/api
# Used by Vite's server-side proxy. Docker overrides this to http://api:8000.
VITE_API_PROXY_TARGET=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8501,http://127.0.0.1:8501
API_BASE_URL=http://localhost:8000
PUBLIC_API_URL=http://localhost:8000

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LEARNER_SESSION_EXPIRE_MINUTES=30
LEARNER_HANDOFF_EXPIRE_SECONDS=180
LEARNER_PIN_MAX_ATTEMPTS=5
LEARNER_PIN_COOLDOWN_SECONDS=60

# AI (safe local default)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MOCK_AI_MODE=true
OPENAI_TIMEOUT_SECONDS=60
OPENAI_RETRY_COUNT=2

MAX_QUESTIONS_PER_REQUEST=10
MAX_ANSWER_LENGTH=2000
MAX_AI_REQUESTS_PER_LEARNER_PER_HOUR=50

